{
  "name": "impulse",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "export EXPO_PUBLIC_APP_VARIANT=development && sh scripts/prebuild-variant.sh development && expo run:android",
    "android:clean": "export EXPO_PUBLIC_APP_VARIANT=development && npx expo prebuild --clean --platform android && npx expo run:android",
    "android:local": "export EXPO_PUBLIC_APP_VARIANT=preview && expo prebuild --clean && cd android && ./gradlew assembleRelease",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "doctor": "npx expo-doctor",
    "drizzle": "npx drizzle-kit generate",
    "impulse:preview": "eas build --profile preview --platform android"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@date-fns/utc": "^2.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.0.14",
    "babel-plugin-inline-import": "^3.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.41.0",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "moti": "^0.30.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "drizzle-kit": "^0.30.5",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
